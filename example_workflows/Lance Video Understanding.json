el.safetensors\n│   │   │   ├── tokenizer.json\n│   │   │   ├── tokenizer_config.json\n│   │   │   └── vocab.json\n│   │   ├── 📂 Qwen2.5-VL-ViT\n│   │   │   ├── config.json\n│   │   │   └── vit.safetensors\n│   │   ├── Wan2.2_VAE.pth\n```\n\n## Issue\nIf you encounter unexpected error, you can open issue [here](https://github.com/SteveImmanuel/comfyui-lance-aio/issues) so I can investigate and fix it.\n\n## References\nHuggingface: [bytedance-research/Lance](https://github.com/bytedance/Lance)\n\nOriginal Codebase: [github.com/bytedance/Lance](https://github.com/bytedance/Lance)\n\nComfyUI Port Codebase: [github.com/SteveImmanuel/comfyui-lance-aio](https://github.com/SteveImmanuel/comfyui-lance-aio)\n"],"color":"#222","bgcolor":"#000"}],"links":[[195,60,0,59,1,"MODEL_ARGS"],[196,60,1,59,2,"INFERENCE_ARGS"],[197,60,2,59,4,"DATA_CONFIG"],[198,60,3,59,3,"STRING"],[199,60,4,59,6,"STRING"],[200,60,5,59,0,"STRING"],[202,62,0,59,5,"STRING"],[221,59,0,69,0,"STRING"],[228,72,0,59,7,"VIDEO"]],"groups":[],"definitions":{"subgraphs":[{"id":"e1511d92-feb4-4e4a-bf10-d225c1294a43","version":1,"state":{"lastGroupId":0,"lastNodeId":73,"lastLinkId":228,"lastRerouteId":0},"revision":0,"config":{},"name":"Lance Understanding Subgraph","inputNode":{"id":-10,"bounding":[1003.056448189589,871.0845936536665,131.53333282470703,208.0000000000001]},"outputNode":{"id":-20,"bounding":[2901.621553000952,931.0845936536665,128,68]},"inputs":[{"id":"6ab88740-4984-4965-bc4b-11fe4ef77b86","name":"ckpt_path","type":"STRING","linkIds":[],"localized_name":"ckpt_path","pos":[1110.589781014296,895.0845936536665]},{"id":"2c9c9c27-9c24-4310-b697-c83a0d1edf1c","name":"model_args","type":"MODEL_ARGS","linkIds":[177,178],"localized_name":"model_args","pos":[1110.589781014296,915.0845936536665]},{"id":"ef3e2f07-7340-4ac6-b9bc-116072e60986","name":"inference_args","type":"INFERENCE_ARGS","linkIds":[180,181,213],"localized_name":"inference_args","pos":[1110.589781014296,935.0845936536665]},{"id":"38bef871-6dc2-4c